class Solution {
    public int maximumWealth(int[][] accounts) {
        int max=Integer.MIN_VALUE;
        for(int i=0;i<accounts.length;i++){
            max=Math.max(max,sum(accounts[i]));
        }
        return max;
    }
    public int sum(int[] arr){
        int sum=0;
        for(int e: arr){
            sum+=e;
        }
        return sum;
    } 
}
